#!/usr/bin/env bash
# Toggle a logind inhibitor that prevents idle-triggered suspend.  The helper
# stays alive for as long as Keep Awake is enabled, so it is also safe to call
# this script from a Plasma global shortcut.
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
state_dir="${runtime_dir}/keep-awake"
pid_file="${state_dir}/inhibitor.pid"

is_active() {
  [[ -r "${pid_file}" ]] && kill -0 "$(<"${pid_file}")" 2>/dev/null
}

status() {
  if is_active; then
    printf '%s\n' active
  else
    printf '%s\n' inactive
  fi
}

notify_state() {
  local state="$1"
  if command -v notify-send >/dev/null; then
    if [[ "${state}" == active ]]; then
      notify-send \
        --app-name='Keep Awake' \
        --icon='preferences-system-power-management' \
        'Keep Awake enabled' \
        'Idle-triggered suspend is now blocked.' || true
    else
      notify-send \
        --app-name='Keep Awake' \
        --icon='system-suspend' \
        'Keep Awake disabled' \
        'Idle-triggered suspend can resume normally.' || true
    fi
  fi
}

start() {
  if is_active; then
    status
    return
  fi

  mkdir -p "${state_dir}"
  rm -f "${pid_file}"
  systemd-inhibit \
    --what=idle:sleep \
    --mode=block \
    --who='Keep Awake' \
    --why='Keep Awake widget is enabled' \
    sleep infinity >/dev/null 2>&1 &
  printf '%s\n' "$!" >"${pid_file}"
  notify_state active
  printf '%s\n' active
}

stop() {
  if is_active; then
    kill "$(<"${pid_file}")"
  fi
  rm -f "${pid_file}"
  notify_state inactive
  printf '%s\n' inactive
}

case "${1:-toggle}" in
  status) status ;;
  on) start ;;
  off) stop ;;
  toggle)
    if is_active; then stop; else start; fi
    ;;
  *)
    printf 'Usage: %s {status|on|off|toggle}\n' "$0" >&2
    exit 64
    ;;
esac
